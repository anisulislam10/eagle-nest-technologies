rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /content/{collection}/{filename} {
      allow get: if collection in ['projects', 'team', 'clients'];
      allow list: if isAdmin();
      allow create: if collection in ['projects', 'team', 'clients'] && isAdmin()
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if collection in ['projects', 'team', 'clients'] && isAdmin();
    }
  }
}
